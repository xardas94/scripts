#!/bin/bash
# Open a file in a suitable app, at a line when the app supports it.
# Usage: open_at PATH [LINE [COL]]
#        open_at PATH:LINE[:COL]

#exec 19>/tmp/open_at.log
#BASH_XTRACEFD=19
#set -x

set -e

file=$1
line=$2
col=$3

# PATH:LINE[:COL] form; don't split when the whole string is an existing file
if [[ -z $line && ! -e $file ]]; then
    if [[ $file =~ ^(.+):([0-9]+):([0-9]+)$ ]]; then
        file=${BASH_REMATCH[1]}
        line=${BASH_REMATCH[2]}
        col=${BASH_REMATCH[3]}
    elif [[ $file =~ ^(.+):([0-9]+)$ ]]; then
        file=${BASH_REMATCH[1]}
        line=${BASH_REMATCH[2]}
    fi
fi

case "$file" in
    *.c|*.cc|*.cpp|*.cxx|*.h|*.hh|*.hpp|*.hxx|*.cmake|*/CMakeLists.txt|CMakeLists.txt|*.qbs)
        exec qtcreator -client "$file${line:+:$line}${line:+${col:+:$col}}"
        ;;
esac

case "$(file --mime-type -b -- "$file")" in
    text/*|inode/x-empty|application/json|application/x-shellscript|application/javascript|application/xml)
        args=()
        [[ -n $line ]] && args+=(-l "$line")
        [[ -n $line && -n $col ]] && args+=(-c "$col")
        exec kate "${args[@]}" -- "$file"
        ;;
    *)
        exec /bin/xdg-open "$file"
        ;;
esac
